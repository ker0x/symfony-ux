{# @prop as 'div' The HTML tag to render. #}
{# @block content The message content displayed inside the bubble. #}
{%- props as = 'div' -%}
<{{ as }}
    data-slot="bubble-content"
    {{ attributes.defaults({
        class: 'w-fit max-w-full min-w-0 overflow-hidden rounded-xl border border-transparent px-3 py-2 text-sm leading-relaxed wrap-break-word group-data-[align=end]/bubble:self-end ltr:[button]:text-left rtl:[button]:text-start [button,a]:transition-colors [button,a]:outline-none [button,a]:focus-visible:border-ring [button,a]:focus-visible:ring-3 [button,a]:focus-visible:ring-ring/50'|tailwind_classes,
    }) }}
>
    {%- block content %}{% endblock -%}
</{{ as }}>
