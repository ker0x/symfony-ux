{# @block content The validation message, replacing the default "Please answer this question." wording. #}
{%- set _questionnaire_itemErrorId = inject('questionnaire.itemErrorId', '') -%}
<p
    id="{{ _questionnaire_itemErrorId }}"
    data-slot="questionnaire-error"
    data-questionnaire-target="error"
    role="alert"
    hidden
    {{ attributes.defaults({
        class: 'mt-2 text-sm text-destructive'|tailwind_classes,
    }) }}
>
    {%- block content %}{% endblock -%}
</p>
