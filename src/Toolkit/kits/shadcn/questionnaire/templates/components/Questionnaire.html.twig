{# @prop id string Unique identifier used to generate internal Questionnaire IDs. #}
{# @prop defaultItem string Name of the `Questionnaire:Item` shown on initial render. #}
{# @prop shortcuts 'letters'|'numbers'|null Keyboard shortcut style assigned to each answer. #}
{# @block content The questionnaire structure, typically includes `Questionnaire:Progress`, `Questionnaire:Item` and `Questionnaire:Actions`. #}
{%- props id = 'questionnaire', defaultItem = '', shortcuts = null -%}
{%- do provide('questionnaire.id', id) -%}
{%- do provide('questionnaire.defaultItem', defaultItem) -%}
<form
    id="{{ id }}"
    data-slot="questionnaire"
    data-questionnaire-active-item-value="{{ defaultItem }}"
    data-questionnaire-shortcuts-value="{{ shortcuts }}"
    {{ attributes.defaults({
        class: 'flex w-full min-w-0 flex-col gap-4'|tailwind_classes,
        'data-controller': 'questionnaire',
        'data-action': 'keydown->questionnaire#onKeyDown submit->questionnaire#onSubmit change->questionnaire#onAnswerChange input->questionnaire#onAnswerInput',
    }) }}
>
    {%- block content %}{% endblock -%}
</form>
